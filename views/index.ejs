<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Mood Tracker</title>

    <!-- Bootstrap CSS and JS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            background-color: #f7f9fc;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: linear-gradient(90deg, #6f42c1, #0d6efd);
            padding: 14px 20px;
        }

        .navbar-brand {
            font-weight: bold;
            color: white !important;
            font-size: 1.3rem;
        }

        .nav-link {
            color: white !important;
            font-weight: 500;
        }

        .nav-link:hover {
            text-decoration: underline;
        }

        .page-title {
            color: #4b2e83;
            font-weight: bold;
            font-size: 2.6rem;
        }

        .content-card {
            background-color: white;
            padding: 28px;
            border-radius: 14px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
        }

        .mood-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            border: 2px solid #212529;
            margin-bottom: 0;
            background-color: white;
        }

        .mood-table th,
        .mood-table td {
            border: 1.5px solid #212529;
            padding: 14px 10px;
            vertical-align: middle;
            text-align: center;
        }

        .mood-table thead th {
            background-color: #f8f9fa;
            color: black;
            font-weight: bold;
        }

        .mood-table tbody tr:nth-child(odd) {
            background-color: white;
        }

        .mood-table tbody tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .mood-table th:nth-child(1),
        .mood-table td:nth-child(1) {
            width: 5%;
        }

        .mood-table th:nth-child(2),
        .mood-table td:nth-child(2) {
            width: 10%;
            white-space: nowrap;
        }

        .mood-table th:nth-child(3),
        .mood-table td:nth-child(3) {
            width: 12%;
        }

        .mood-table th:nth-child(4),
        .mood-table td:nth-child(4),
        .mood-table th:nth-child(5),
        .mood-table td:nth-child(5) {
            width: 9%;
        }

        .mood-table th:nth-child(6),
        .mood-table td:nth-child(6) {
            width: 23%;
            text-align: left;
        }

        .mood-table th:nth-child(7),
        .mood-table td:nth-child(7) {
            width: 13%;
        }

        .mood-table th:nth-child(8),
        .mood-table td:nth-child(8),
        .mood-table th:nth-child(9),
        .mood-table td:nth-child(9) {
            width: 10%;
        }

        .badge {
            font-size: 0.8rem;
            padding: 8px 10px;
        }

        .btn {
            border-radius: 6px;
        }
    </style>
</head>

<body>

    <!-- Reusable navigation bar -->
    <%- include('partials/navbar.ejs') %>

    <div class="container mt-4">

        <!-- Page title card -->
        <div class="content-card mb-4">
            <h1 class="page-title">Daily Mood Tracker</h1>
            <p class="text-muted mb-0">
                Track your mood, energy, stress level, and daily reflection.
            </p>
        </div>

        <!-- Mood entries table -->
        <div class="content-card">
            <div class="table-responsive">
                <table class="mood-table">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Date</th>
                            <th>Mood</th>
                            <th>Energy</th>
                            <th>Stress</th>
                            <th>Comment</th>
                            <th>Status</th>
                            <th>Edit</th>
                            <th>Delete</th>
                        </tr>
                    </thead>

                    <tbody>
                        <!-- Loop through all mood entries and display each one -->
                        <% for (let i = 0; i < moods.length; i++) { %>
                            <tr>
                                <td><%= i + 1 %></td>

                                <td><%= formatDate(moods[i].date) %></td>

                                <td>
                                    <% if (moods[i].mood === 'Focused') { %>
                                        <span class="badge bg-primary">Focused</span>
                                    <% } else if (moods[i].mood === 'Motivated') { %>
                                        <span class="badge bg-success">Motivated</span>
                                    <% } else if (moods[i].mood === 'Calm') { %>
                                        <span class="badge bg-info text-dark">Calm</span>
                                    <% } else if (moods[i].mood === 'Drained') { %>
                                        <span class="badge bg-secondary">Drained</span>
                                    <% } else if (moods[i].mood === 'Stressed') { %>
                                        <span class="badge bg-danger">Stressed</span>
                                    <% } else { %>
                                        <span class="badge bg-dark"><%= moods[i].mood %></span>
                                    <% } %>
                                </td>

                                <td><%= moods[i].energy %></td>

                                <td><%= moods[i].stress %></td>

                                <td><%= moods[i].comment %></td>

                                <!-- Mood status based on mood and stress level -->
                                <td>
                                    <% const status = getMoodStatus(moods[i].mood, moods[i].stress); %>

                                    <% if (status === 'Productive') { %>
                                        <span class="badge bg-success">Productive</span>
                                    <% } else if (status === 'Balanced') { %>
                                        <span class="badge bg-info text-dark">Balanced</span>
                                    <% } else if (status === 'Needs Rest') { %>
                                        <span class="badge bg-warning text-dark">Needs Rest</span>
                                    <% } else if (status === 'Low Energy') { %>
                                        <span class="badge bg-secondary">Low Energy</span>
                                    <% } else { %>
                                        <span class="badge bg-dark">Neutral</span>
                                    <% } %>
                                </td>

                                <td>
                                    <a href="/moods/<%= moods[i].id %>/update" class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>
                                </td>

                                <td>
                                    <a href="/moods/<%= moods[i].id %>/delete" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</body>
</html>